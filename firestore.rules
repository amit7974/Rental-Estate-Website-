rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Properties collection
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.sellerId == request.auth.uid || request.auth.token.email == 'aayanraj934@gmail.com');
    }

    // Viewings / Bookings collection
    match /viewings/{viewingId} {
      allow read: if request.auth != null;
      allow create: if true; // Allows registered users or guests with contact info to book viewings
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.sellerId == request.auth.uid);
    }
  }
}
